    <!-- worker_crossing: 1.0 m/s, 좁은 통로 입구 횡단 (명세 4.7: 1.0 m/s 동적 장애물), 루프 25.0 s, 웨이포인트 27개 -->
    <actor name="worker_crossing">
      <pose>0 0 0 0 0 0</pose>
      <skin><filename>model://worker/meshes/worker.dae</filename><scale>1.0</scale></skin>
      <animation name="walk"><filename>model://worker/meshes/worker.dae</filename></animation>
      <script>
        <loop>true</loop>
        <delay_start>0.0</delay_start>
        <auto_start>true</auto_start>
        <trajectory id="0" type="walk" tension="0">
          <waypoint><time>0.000</time><pose>-6.0000 -7.0000 0.0000 0.0000 0.0000 0.0000</pose></waypoint>
          <waypoint><time>1.000</time><pose>-5.0000 -7.0000 0.0000 0.0000 0.0000 0.0000</pose></waypoint>
          <waypoint><time>2.000</time><pose>-4.0000 -7.0000 0.0000 0.0000 0.0000 0.0000</pose></waypoint>
          <waypoint><time>3.000</time><pose>-3.0000 -7.0000 0.0000 0.0000 0.0000 0.0000</pose></waypoint>
          <waypoint><time>4.000</time><pose>-2.0000 -7.0000 0.0000 0.0000 0.0000 0.0000</pose></waypoint>
          <waypoint><time>5.000</time><pose>-1.0000 -7.0000 0.0000 0.0000 0.0000 0.0000</pose></waypoint>
          <waypoint><time>6.000</time><pose>0.0000 -7.0000 0.0000 0.0000 0.0000 0.0000</pose></waypoint>
          <waypoint><time>7.000</time><pose>1.0000 -7.0000 0.0000 0.0000 0.0000 0.0000</pose></waypoint>
          <waypoint><time>8.000</time><pose>2.0000 -7.0000 0.0000 0.0000 0.0000 0.0000</pose></waypoint>
          <waypoint><time>9.000</time><pose>3.0000 -7.0000 0.0000 0.0000 0.0000 0.0000</pose></waypoint>
          <waypoint><time>10.000</time><pose>4.0000 -7.0000 0.0000 0.0000 0.0000 0.0000</pose></waypoint>
          <waypoint><time>11.000</time><pose>5.0000 -7.0000 0.0000 0.0000 0.0000 0.0000</pose></waypoint>
          <waypoint><time>12.000</time><pose>6.0000 -7.0000 0.0000 0.0000 0.0000 0.0000</pose></waypoint>
          <waypoint><time>12.500</time><pose>6.0000 -7.0000 0.0000 0.0000 0.0000 3.1416</pose></waypoint>
          <waypoint><time>13.500</time><pose>5.0000 -7.0000 0.0000 0.0000 0.0000 3.1416</pose></waypoint>
          <waypoint><time>14.500</time><pose>4.0000 -7.0000 0.0000 0.0000 0.0000 3.1416</pose></waypoint>
