    <!-- ===== 바닥 / 외벽 ===== -->
    <!-- 바닥 60 x 40 m. μ=0.8:
         건조 콘크리트-고무(우레탄) 바퀴 0.6~0.85 범위의 중간값 (Engineering ToolBox) -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>60 40</size></plane></geometry>
          <surface><friction><ode>
            <mu>0.8</mu><mu2>0.8</mu2>
          </ode></friction></surface>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>60 40</size></plane></geometry>
          <material>
            <ambient>0.55 0.55 0.53 1</ambient><diffuse>0.55 0.55 0.53 1</diffuse>
            <specular>0.05 0.05 0.05 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- 외벽 (두께 0.2 m, 높이 4.0 m),
         안쪽 면 x=±29.8, y=±19.8 -->
    <model name="warehouse_walls">
      <static>true</static>
      <link name="link">
        <collision name="wall_north_collision">
          <pose>0.0000 19.9000 2.0000 0.0000 0.0000 0.0000</pose>
          <geometry><box><size>60.0 0.2 4.0</size></box></geometry>
        </collision>
        <visual name="wall_north">
          <pose>0.0000 19.9000 2.0000 0.0000 0.0000 0.0000</pose>
          <geometry><box><size>60.0 0.2 4.0</size></box></geometry>
          <material>
            <ambient>0.75 0.75 0.72 1</ambient><diffuse>0.75 0.75 0.72 1</diffuse>
          </material>
        </visual>
        <collision name="wall_south_collision">
          <pose>0.0000 -19.9000 2.0000 0.0000 0.0000 0.0000</pose>
          <geometry><box><size>60.0 0.2 4.0</size></box></geometry>
        </collision>
        <visual name="wall_south">
          <pose>0.0000 -19.9000 2.0000 0.0000 0.0000 0.0000</pose>
          <geometry><box><size>60.0 0.2 4.0</size></box></geometry>
          <material>
            <ambient>0.75 0.75 0.72 1</ambient><diffuse>0.75 0.75 0.72 1</diffuse>
          </material>
        </visual>
        <collision name="wall_east_collision">
          <pose>29.9000 0.0000 2.0000 0.0000 0.0000 0.0000</pose>
          <geometry><box><size>0.2 40.0 4.0</size></box></geometry>
        </collision>
        <visual name="wall_east">
          <pose>29.9000 0.0000 2.0000 0.0000 0.0000 0.0000</pose>
          <geometry><box><size>0.2 40.0 4.0</size></box></geometry>
          <material>
            <ambient>0.75 0.75 0.72 1</ambient><diffuse>0.75 0.75 0.72 1</diffuse>
