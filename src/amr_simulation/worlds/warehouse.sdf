    <!-- ===== 랙: A/B/C 열 7베이씩 (21) + 좁은 통로 4베이 (rack_narrow_*) =====
         좁은 통로: 중심 (0.0, -10.0), y 방향 4 m,
         순폭 0.6 m = 로봇 폭 0.40 + 0.20 (명세 4.4).
         북쪽 입구 y=-8.0, 남쪽 출구 y=-12.0.
         worker_crossing 이 입구 앞 y=-7 을 1.0 m/s 로 횡단한다. -->
    <include>
      <uri>model://rack</uri>
      <name>rack_A1</name>
