    <!-- forklift_main: 지게차 (2.5 t, 전진·후진 왕복), x -20..20, 1.5 m/s, 가감속 1.0 m/s² (반전 1.5 s 감속 + 1.5 s 가속) -->
    <include>
      <uri>model://forklift</uri>
      <name>forklift_main</name>
      <pose>-18.9750 15.0000 0.0000 0.0000 0.0000 0.0000</pose>
      <plugin filename="ignition-gazebo-diff-drive-system" name="ignition::gazebo::systems::DiffDrive">
        <left_joint>wheel_left_joint</left_joint>
        <right_joint>wheel_right_joint</right_joint>
        <wheel_separation>1.1</wheel_separation>
        <wheel_radius>0.25</wheel_radius>
        <topic>/model/forklift_main/cmd_vel</topic>
        <odom_topic>/model/forklift_main/diff_drive/odom</odom_topic>
        <tf_topic>/model/forklift_main/diff_drive/tf</tf_topic>
        <max_linear_velocity>1.5</max_linear_velocity>
        <min_linear_velocity>-1.5</min_linear_velocity>
        <max_linear_acceleration>1.0</max_linear_acceleration>
        <min_linear_acceleration>-1.0</min_linear_acceleration>
      </plugin>
      <plugin filename="ignition-gazebo-pose-publisher-system" name="ignition::gazebo::systems::PosePublisher">
        <!-- Fortress PosePublisher 는 모델 자신의 포즈를
             publish_nested_model_pose && publish_model_pose 일 때만 낸다 (하위 호환 코드) -->
        <publish_model_pose>true</publish_model_pose>
        <publish_nested_model_pose>true</publish_nested_model_pose>
        <publish_link_pose>false</publish_link_pose>
        <publish_collision_pose>false</publish_collision_pose>
        <publish_visual_pose>false</publish_visual_pose>
        <publish_sensor_pose>false</publish_sensor_pose>
        <use_pose_vector_msg>false</use_pose_vector_msg>
        <static_publisher>false</static_publisher>
        <update_frequency>50</update_frequency>
      </plugin>
      <plugin filename="ignition-gazebo-odometry-publisher-system" name="ignition::gazebo::systems::OdometryPublisher">
        <odom_frame>world</odom_frame>
        <robot_base_frame>forklift_main</robot_base_frame>
        <odom_topic>/model/forklift_main/odometry</odom_topic>
        <tf_topic>/model/forklift_main/odometry/tf</tf_topic>
        <odom_publish_frequency>50</odom_publish_frequency>
        <dimensions>2</dimensions>
      </plugin>
      <plugin filename="ignition-gazebo-triggered-publisher-system" name="ignition::gazebo::systems::TriggeredPublisher">
        <input type="ignition.msgs.Pose" topic="/model/forklift_main/pose">
          <match field="position.x" tol="0.25">19.125</match>
        </input>
        <output type="ignition.msgs.Twist" topic="/model/forklift_main/cmd_vel">linear: {x: -1.5}</output>
      </plugin>
      <plugin filename="ignition-gazebo-triggered-publisher-system" name="ignition::gazebo::systems::TriggeredPublisher">
        <input type="ignition.msgs.Pose" topic="/model/forklift_main/pose">
          <match field="position.x" tol="0.25">-19.125</match>
        </input>
        <output type="ignition.msgs.Twist" topic="/model/forklift_main/cmd_vel">linear: {x: 1.5}</output>
      </plugin>
    </include>
    <!-- shuttle_amr: 다른 회사 AMR 셔틀 (0.6 x 0.4 m, 전진·후진 왕복), y -6..11, 1.0 m/s, 가감속 0.8 m/s² (반전 1.2 s 감속 + 1.2 s 가속) -->
    <include>
      <uri>model://shuttle_amr</uri>
      <name>shuttle_amr</name>
      <pose>9.0000 -5.4750 0.0000 0.0000 0.0000 1.5708</pose>
      <plugin filename="ignition-gazebo-diff-drive-system" name="ignition::gazebo::systems::DiffDrive">
        <left_joint>wheel_left_joint</left_joint>
        <right_joint>wheel_right_joint</right_joint>
        <wheel_separation>0.36</wheel_separation>
        <wheel_radius>0.0825</wheel_radius>
        <topic>/model/shuttle_amr/cmd_vel</topic>
        <odom_topic>/model/shuttle_amr/diff_drive/odom</odom_topic>
        <tf_topic>/model/shuttle_amr/diff_drive/tf</tf_topic>
        <max_linear_velocity>1.0</max_linear_velocity>
        <min_linear_velocity>-1.0</min_linear_velocity>
        <max_linear_acceleration>0.8</max_linear_acceleration>
        <min_linear_acceleration>-0.8</min_linear_acceleration>
      </plugin>
      <plugin filename="ignition-gazebo-pose-publisher-system" name="ignition::gazebo::systems::PosePublisher">
        <!-- Fortress PosePublisher 는 모델 자신의 포즈를
             publish_nested_model_pose && publish_model_pose 일 때만 낸다 (하위 호환 코드) -->
        <publish_model_pose>true</publish_model_pose>
        <publish_nested_model_pose>true</publish_nested_model_pose>
        <publish_link_pose>false</publish_link_pose>
        <publish_collision_pose>false</publish_collision_pose>
        <publish_visual_pose>false</publish_visual_pose>
        <publish_sensor_pose>false</publish_sensor_pose>
        <use_pose_vector_msg>false</use_pose_vector_msg>
        <static_publisher>false</static_publisher>
        <update_frequency>50</update_frequency>
      </plugin>
      <plugin filename="ignition-gazebo-odometry-publisher-system" name="ignition::gazebo::systems::OdometryPublisher">
        <odom_frame>world</odom_frame>
        <robot_base_frame>shuttle_amr</robot_base_frame>
        <odom_topic>/model/shuttle_amr/odometry</odom_topic>
        <tf_topic>/model/shuttle_amr/odometry/tf</tf_topic>
        <odom_publish_frequency>50</odom_publish_frequency>
        <dimensions>2</dimensions>
      </plugin>
      <plugin filename="ignition-gazebo-triggered-publisher-system" name="ignition::gazebo::systems::TriggeredPublisher">
        <input type="ignition.msgs.Pose" topic="/model/shuttle_amr/pose">
          <match field="position.y" tol="0.25">10.625</match>
        </input>
        <output type="ignition.msgs.Twist" topic="/model/shuttle_amr/cmd_vel">linear: {x: -1.0}</output>
      </plugin>
      <plugin filename="ignition-gazebo-triggered-publisher-system" name="ignition::gazebo::systems::TriggeredPublisher">
        <input type="ignition.msgs.Pose" topic="/model/shuttle_amr/pose">
          <match field="position.y" tol="0.25">-5.625</match>
        </input>
        <output type="ignition.msgs.Twist" topic="/model/shuttle_amr/cmd_vel">linear: {x: 1.0}</output>
      </plugin>
    </include>
  </world>
</sdf>
