    <!-- ===== 바닥 / 외벽 / 천장 ===== -->
    <!-- 바닥 64 x 44 m (벽 밖까지). μ=0.8:
         건조 콘크리트-고무(우레탄) 바퀴 0.6~0.85 범위의 중간값 (Engineering ToolBox). 알베도 0.35 (콘크리트) -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry><plane><normal>0 0 1</normal><size>64 44</size></plane></geometry>
          <surface><friction><ode>
            <mu>0.8</mu><mu2>0.8</mu2>
          </ode></friction></surface>
        </collision>
        <visual name="visual">
          <geometry><plane><normal>0 0 1</normal><size>64 44</size></plane></geometry>
          <material>
            <ambient>0.35 0.35 0.33 1</ambient><diffuse>0.35 0.35 0.33 1</diffuse>
            <specular>0.05 0.05 0.05 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- 외벽 (두께 0.2 m, 높이 8.0 m),
         안쪽 면 x=±30.0, y=±20.0 → 내부 60 x 40 m -->
    <model name="warehouse_walls">
      <static>true</static>
      <link name="link">
        <collision name="wall_north_collision">
          <pose>0.0000 20.1000 4.0000 0.0000 0.0000 0.0000</pose>
          <geometry><box><size>60.4 0.2 8.0</size></box></geometry>
        </collision>
        <visual name="wall_north">
          <pose>0.0000 20.1000 4.0000 0.0000 0.0000 0.0000</pose>
          <geometry><box><size>60.4 0.2 8.0</size></box></geometry>
          <material>
            <ambient>0.72 0.72 0.70 1</ambient><diffuse>0.72 0.72 0.70 1</diffuse>
          </material>
        </visual>
        <collision name="wall_south_collision">
          <pose>0.0000 -20.1000 4.0000 0.0000 0.0000 0.0000</pose>
          <geometry><box><size>60.4 0.2 8.0</size></box></geometry>
        </collision>
        <visual name="wall_south">
          <pose>0.0000 -20.1000 4.0000 0.0000 0.0000 0.0000</pose>
          <geometry><box><size>60.4 0.2 8.0</size></box></geometry>
          <material>
            <ambient>0.72 0.72 0.70 1</ambient><diffuse>0.72 0.72 0.70 1</diffuse>
          </material>
        </visual>
        <collision name="wall_east_collision">
          <pose>30.1000 0.0000 4.0000 0.0000 0.0000 0.0000</pose>
          <geometry><box><size>0.2 40.4 8.0</size></box></geometry>
        </collision>
        <visual name="wall_east">
          <pose>30.1000 0.0000 4.0000 0.0000 0.0000 0.0000</pose>
          <geometry><box><size>0.2 40.4 8.0</size></box></geometry>
          <material>
            <ambient>0.72 0.72 0.70 1</ambient><diffuse>0.72 0.72 0.70 1</diffuse>
          </material>
        </visual>
        <collision name="wall_west_collision">
          <pose>-30.1000 0.0000 4.0000 0.0000 0.0000 0.0000</pose>
          <geometry><box><size>0.2 40.4 8.0</size></box></geometry>
        </collision>
        <visual name="wall_west">
          <pose>-30.1000 0.0000 4.0000 0.0000 0.0000 0.0000</pose>
          <geometry><box><size>0.2 40.4 8.0</size></box></geometry>
          <material>
            <ambient>0.72 0.72 0.70 1</ambient><diffuse>0.72 0.72 0.70 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

