          <waypoint><time>18.500</time><pose>0.0000 -7.0000 0.0000 0.0000 0.0000 3.1416</pose></waypoint>
          <waypoint><time>19.500</time><pose>-1.0000 -7.0000 0.0000 0.0000 0.0000 3.1416</pose></waypoint>
          <waypoint><time>20.500</time><pose>-2.0000 -7.0000 0.0000 0.0000 0.0000 3.1416</pose></waypoint>
          <waypoint><time>21.500</time><pose>-3.0000 -7.0000 0.0000 0.0000 0.0000 3.1416</pose></waypoint>
