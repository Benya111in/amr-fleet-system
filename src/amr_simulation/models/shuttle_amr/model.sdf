<?xml version="1.0" ?>
<!--
  "다른 로봇" 동적 장애물 — 다른 회사 AMR 셔틀 (명세 4.1 동적 장애물 "다른 로봇"). 모델 원점 = 차체 바닥 중심의 지면 투영.
  - 우리 AMR 과 같은 급 크기(차체 0.60 x 0.40 x 0.30 m, 지면 +0.03 ~ +0.33, 60 kg)라 LiDAR 스캔 평면(+0.20)에 전체
    외곽이 잡힌다. 흰 차체 + 빨간 범퍼 띠 + 위쪽 LiDAR 원통 + 주황 경광등 (우리 로봇의 파란 차체와 구분).
  - 구동륜 2개(revolute, wheel_left_joint / wheel_right_joint, 간격 0.36, 반지름 0.0825, 토크 한계 4 N·m) + 저마찰 구
    캐스터 2개. 토크 한계 때문에 우리 로봇을 밀어붙이지 못하고 막히면 멈춘다.
  - 구동: 월드 파일이 include 안에 DiffDrive(가감속 0.8 m/s²) + PosePublisher + OdometryPublisher + TriggeredPublisher 를
    붙여 전진·후진으로 왕복한다 (worlds/gen_warehouse_world.py VEHICLES). 앞뒤가 대칭인 양방향 셔틀 형상이다.
-->
<sdf version="1.8">
  <model name="shuttle_amr">
    <link name="body">
      <inertial>
        <pose>0 0 0.18 0 0 0</pose>
        <mass>60</mass>
        <!-- 균질 박스 0.6 x 0.4 x 0.3: m/12 (w²+h²), (l²+h²), (l²+w²) -->
        <inertia><ixx>1.25</ixx><iyy>2.25</iyy><izz>2.6</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
      </inertial>
      <collision name="body_collision">
        <pose>0 0 0.18 0 0 0</pose>
        <geometry><box><size>0.60 0.40 0.30</size></box></geometry>
      </collision>
      <visual name="body">
        <pose>0 0 0.18 0 0 0</pose>
        <geometry><box><size>0.60 0.40 0.30</size></box></geometry>
        <material><ambient>0.85 0.86 0.88 1</ambient><diffuse>0.85 0.86 0.88 1</diffuse><specular>0.2 0.2 0.2 1</specular></material>
      </visual>
      <visual name="bumper_band">
        <pose>0 0 0.10 0 0 0</pose>
        <geometry><box><size>0.604 0.404 0.05</size></box></geometry>
        <material><ambient>0.75 0.10 0.10 1</ambient><diffuse>0.75 0.10 0.10 1</diffuse></material>
      </visual>
      <visual name="deck">
        <pose>0 0 0.335 0 0 0</pose>
        <geometry><box><size>0.56 0.36 0.01</size></box></geometry>
        <material><ambient>0.20 0.20 0.22 1</ambient><diffuse>0.20 0.20 0.22 1</diffuse></material>
      </visual>
      <visual name="lidar">
        <pose>0 0 0.37 0 0 0</pose>
        <geometry><cylinder><radius>0.045</radius><length>0.06</length></cylinder></geometry>
        <material><ambient>0.08 0.08 0.08 1</ambient><diffuse>0.08 0.08 0.08 1</diffuse></material>
      </visual>
      <visual name="beacon">
        <pose>0.25 0.15 0.36 0 0 0</pose>
        <geometry><cylinder><radius>0.02</radius><length>0.04</length></cylinder></geometry>
        <material><ambient>1.0 0.55 0.05 1</ambient><diffuse>1.0 0.55 0.05 1</diffuse><emissive>0.6 0.3 0.0 1</emissive></material>
      </visual>
      <collision name="caster_front">
        <pose>0.24 0 0.03 0 0 0</pose>
        <geometry><sphere><radius>0.03</radius></sphere></geometry>
        <surface><friction><ode><mu>0.05</mu><mu2>0.05</mu2></ode></friction></surface>
      </collision>
      <collision name="caster_rear">
        <pose>-0.24 0 0.03 0 0 0</pose>
        <geometry><sphere><radius>0.03</radius></sphere></geometry>
        <surface><friction><ode><mu>0.05</mu><mu2>0.05</mu2></ode></friction></surface>
      </collision>
    </link>

    <link name="wheel_left">
      <pose>0 0.18 0.0825 0 0 0</pose>
      <inertial>
        <mass>1.0</mass>
        <inertia><ixx>0.0018</ixx><iyy>0.0034</iyy><izz>0.0018</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
      </inertial>
      <!-- 얇은 원판 충돌 (우리 AMR 과 같은 이유: 제자리 회전 시 실효 바퀴 간격 고정) -->
      <collision name="collision">
        <pose>0 0 0 1.5708 0 0</pose>
        <geometry><cylinder><radius>0.0825</radius><length>0.002</length></cylinder></geometry>
        <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface>
      </collision>
      <visual name="visual">
        <pose>0 0 0 1.5708 0 0</pose>
        <geometry><cylinder><radius>0.0825</radius><length>0.035</length></cylinder></geometry>
        <material><ambient>0.1 0.1 0.1 1</ambient><diffuse>0.1 0.1 0.1 1</diffuse></material>
      </visual>
    </link>
    <link name="wheel_right">
      <pose>0 -0.18 0.0825 0 0 0</pose>
      <inertial>
        <mass>1.0</mass>
        <inertia><ixx>0.0018</ixx><iyy>0.0034</iyy><izz>0.0018</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
      </inertial>
      <collision name="collision">
        <pose>0 0 0 1.5708 0 0</pose>
        <geometry><cylinder><radius>0.0825</radius><length>0.002</length></cylinder></geometry>
        <surface><friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction></surface>
      </collision>
      <visual name="visual">
        <pose>0 0 0 1.5708 0 0</pose>
        <geometry><cylinder><radius>0.0825</radius><length>0.035</length></cylinder></geometry>
        <material><ambient>0.1 0.1 0.1 1</ambient><diffuse>0.1 0.1 0.1 1</diffuse></material>
      </visual>
    </link>
    <joint name="wheel_left_joint" type="revolute">
      <parent>body</parent>
      <child>wheel_left</child>
      <axis><xyz>0 1 0</xyz><limit><lower>-1e16</lower><upper>1e16</upper><effort>4</effort></limit></axis>
    </joint>
    <joint name="wheel_right_joint" type="revolute">
      <parent>body</parent>
      <child>wheel_right</child>
      <axis><xyz>0 1 0</xyz><limit><lower>-1e16</lower><upper>1e16</upper><effort>4</effort></limit></axis>
    </joint>
  </model>
</sdf>
