<?xml version="1.0" ?>
<!--
  중형 화물 상자: 0.50 x 0.40 x 0.30 m, 10.0 kg. 모델 원점 = 바닥 중심.
  관성: ixx = 10/12*(0.40^2+0.30^2) = 0.208333, iyy = 10/12*(0.50^2+0.30^2) = 0.283333, izz = 10/12*(0.50^2+0.40^2) = 0.341667
-->
<sdf version="1.8">
  <model name="box_medium">
    <link name="link">
      <pose>0 0 0.15 0 0 0</pose>
      <inertial>
        <mass>10.0</mass>
        <inertia><ixx>0.208333</ixx><iyy>0.283333</iyy><izz>0.341667</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia>
      </inertial>
      <collision name="collision">
        <geometry><box><size>0.50 0.40 0.30</size></box></geometry>
        <surface><friction><ode><mu>0.6</mu><mu2>0.6</mu2></ode></friction></surface>
      </collision>
      <visual name="visual">
        <geometry><box><size>0.50 0.40 0.30</size></box></geometry>
        <material>
          <ambient>0.72 0.52 0.30 1</ambient>
          <diffuse>0.72 0.52 0.30 1</diffuse>
        </material>
      </visual>
    </link>
  </model>
</sdf>
