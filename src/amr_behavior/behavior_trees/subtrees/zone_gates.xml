<?xml version="1.0" encoding="UTF-8"?>
<!--
  분산 플릿 존 게이트 (보너스 4 P3 · b4-wire) — 분산 트리(task_executor_distributed.xml)가 포함한다. 중앙 트리
  (task_executor.xml)는 포함하지 않는다. 존 노드는 분산 모드 실행기만 등록한다 (registerFleetAgentNodes).

  PickupLocked: 픽업 시작 직전에 작업 ID 잠금 확정(CommitTaskLock). 거부(다른 로봇이 확정) · 시간 초과(sim 30 s,
    노드 시계)면 FAILURE — 이 로봇은 픽업하지 않는다. 인자: task_id (메인 트리의 IsTaskAssigned 출력)

  ZoneMoveTo (명시 사슬 — 분산 트리는 쓰지 않는다): 결정점(decision_goal)까지 → 사슬 전체 허가 대기
    (AcquireZoneChain, 과반 ENTER_ACK) → ReactiveSequence 가 매 tick ZoneGuard 로 허가를 다시 보며 사슬 너머 goal 까지
    → 해제 요청(ReleaseZones). 인자: decision_goal, goal (PoseStamped), zones ("x_ab_1;x_ab_2"), priority,
    zone_timeout_ms. 실제 주행 경로의 사슬 · 결정점은 주행 전에 알 수 없고 경로 하나가 사슬 여럿을 지나므로,
    분산 트리는 이 서브트리 대신 에이전트 경로 게이트(plan → 사슬 사전 요청 · 결정점 정지)와 TrafficGate 의
    ZonePathClear 를 쓴다 (p3.md §10.1). 에이전트가 경로 게이트를 켜면 명시 ACQUIRE 와 함께 쓰지 않는다.
-->
<root>
  <BehaviorTree ID="ZoneMoveTo">
    <Sequence name="ZoneChainPass">
      <NavigateToPose name="ToDecisionPoint" goal="{decision_goal}"/>
      <AcquireZoneChain zones="{zones}" priority="{priority}" timeout_ms="{zone_timeout_ms}"/>
      <ReactiveSequence name="GuardedPass">
        <ZoneGuard zones="{zones}"/>
        <NavigateToPose name="ThroughChain" goal="{goal}"/>
      </ReactiveSequence>
      <ReleaseZones zones="{zones}"/>
    </Sequence>
  </BehaviorTree>

  <BehaviorTree ID="PickupLocked">
    <CommitTaskLock task_id="{task_id}" timeout_ms="30000"/>
  </BehaviorTree>
</root>
