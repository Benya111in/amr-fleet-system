<?xml version="1.0" encoding="UTF-8"?>
<!--
  Charge: 배터리 < battery_low_percent 이고 작업이 없을 때 충전소로 이동·도킹 후 충전.
    설정: charger_dock_ids(실행기 → SelectCharger), battery_resume_percent, charge_timeout_ms, undock_dist

  SelectCharger 가 빈 충전소를 점유(로봇마다 다른 첫 선택, /fleet/charger_claims 로 서로 알림)하고 매 tick
  재평가한다 — 같은 충전소를 늦게 고른 로봇은 도킹 전이면 다른 충전소로 바꿔 다시 시작한다 (도킹 뒤에는 유지).
  ChargeCycle 은 진행 단계를 charge_step 에 저장한다 → E-stop 으로 halt 되면 끝낸 단계를 건너뛰고 재개하며,
  메인 트리 Idle 은 charge_step > 0 이면 잔량과 무관하게 Charge 를 이어 한다 (이탈 후진까지).
  ChargingSession 은 충전 창 동안만 charging/enable = true 이고, 끝나거나 halt 되면 즉시 false.
  충전 중(executor/phase CHARGING)에는 assign_task 를 거절한다. 배터리가 battery_resume_percent 에 닿거나
  charge_timeout_ms 가 지나면 후진으로 이탈(Undock)하고 점유를 풀고 Idle 로 돌아간다.
-->
<root>
  <BehaviorTree ID="Charge">
    <Sequence name="ChargeSteps">
      <ReactiveSequence name="HoldChargerClaim">
        <SelectCharger charger_goal="{charger_goal}" charger_dock_id="{charger_dock_id}" progress="{charge_step}"
                       lock_step="2"/>
        <ResumableSequence name="ChargeCycle" progress_key="charge_step">
          <SubTreePlus ID="MoveTo" goal="{charger_goal}" phase="MOVING" __autoremap="true"/>
          <SubTreePlus ID="DockAt" dock_id="{charger_dock_id}" approach_pose="{charger_goal}" __autoremap="true"/>
          <Sequence name="ChargeWindow">
            <SetPhase phase="CHARGING"/>
            <ForceSuccess>
              <ChargingSession>
                <Timeout msec="{charge_timeout_ms}">
                  <KeepRunningUntilSuccess name="WaitCharged">
                    <IsBatteryOk min_percent="{battery_resume_percent}"/>
                  </KeepRunningUntilSuccess>
                </Timeout>
              </ChargingSession>
            </ForceSuccess>
          </Sequence>
          <SubTreePlus ID="Undock" __autoremap="true"/>
        </ResumableSequence>
      </ReactiveSequence>
      <ReleaseCharger/>
    </Sequence>
  </BehaviorTree>
</root>
