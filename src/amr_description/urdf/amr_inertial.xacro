<?xml version="1.0"?>
<!--
  관성 텐서 매크로. 비대각 성분은 항상 0 (단순 기하, 대칭 배치).

  inertial_diag  차체/바퀴/캐스터 — config/robot_params.yaml 의 base_inertia / wheel_inertia / caster_inertia
                 (해석식과 근거는 YAML 주석에 있음). YAML 이 단일 진실 공급원이므로 여기서 다시 계산하지 않는다.
  inertial_box   적재물(cargo_link) — 질량이 런치 인자(payload_mass)라 YAML 에 없어 균질 박스 해석식으로 계산
                   Ixx = m/12 (y² + z²),  Iyy = m/12 (x² + z²),  Izz = m/12 (x² + y²)
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:macro name="inertial_diag" params="mass ixx iyy izz *origin">
    <inertial>
      <xacro:insert_block name="origin"/>
      <mass value="${mass}"/>
      <inertia ixx="${ixx}" ixy="0.0" ixz="0.0" iyy="${iyy}" iyz="0.0" izz="${izz}"/>
    </inertial>
  </xacro:macro>

  <xacro:macro name="inertial_box" params="mass x y z *origin">
    <inertial>
      <xacro:insert_block name="origin"/>
      <mass value="${mass}"/>
      <inertia ixx="${mass / 12.0 * (y * y + z * z)}" ixy="0.0" ixz="0.0"
               iyy="${mass / 12.0 * (x * x + z * z)}" iyz="0.0"
               izz="${mass / 12.0 * (x * x + y * y)}"/>
    </inertial>
  </xacro:macro>

</robot>
