<!--
  amr_navigation 기본 NavigateToPose BT (components.md §3.3).
  - 재계획: RateController 1 Hz 주기 재계획 + TTC 트리거 즉시 재계획.
    IsTTCBelowThreshold (amr_behavior 패키지의 Nav2 BT 조건 플러그인,
    라이브러리 amr_is_ttc_below_threshold_condition_bt_node) 가 perception/tracked_obstacles 의 최소 TTC 가
    threshold [s] 미만이면 SUCCESS → 주기를 기다리지 않고 ComputePathToPose 실행 (cooldown 으로 과재계획 방지).
  - 계획기/제어기 선택: PlannerSelector / ControllerSelector (토픽 planner_selector / controller_selector,
    latched). 기본 AStar / DWA. 구간별로 PurePursuit, 비교 실험용 NavFn / Smac / DWB 선택 가능.
  - 복구: Nav2 기본 BT 와 같은 RoundRobin (코스트맵 초기화 → 제자리 회전 → 대기 → 후진).
  amr_behavior 가 설치되지 않은 환경에서는 navigate_to_pose_no_ttc.xml 이 쓰인다 (navigation.launch.py 가 자동 선택).
-->
<root main_tree_to_execute="MainTree">
  <BehaviorTree ID="MainTree">
    <RecoveryNode number_of_retries="6" name="NavigateRecovery">
      <PipelineSequence name="NavigateWithReplanning">
        <PlannerSelector selected_planner="{selected_planner}" default_planner="AStar" topic_name="planner_selector"/>
        <ControllerSelector selected_controller="{selected_controller}" default_controller="DWA" topic_name="controller_selector"/>
        <ReactiveFallback name="ReplanOnTTCOrRate">
          <Sequence name="TTCReplan">
            <IsTTCBelowThreshold threshold="2.0" cooldown="1.0" only_dynamic="true"/>
            <ComputePathToPose goal="{goal}" path="{path}" planner_id="{selected_planner}"/>
          </Sequence>
          <RateController hz="1.0">
            <RecoveryNode number_of_retries="1" name="ComputePathToPose">
              <ComputePathToPose goal="{goal}" path="{path}" planner_id="{selected_planner}"/>
              <ClearEntireCostmap name="ClearGlobalCostmap-Context" service_name="global_costmap/clear_entirely_global_costmap"/>
            </RecoveryNode>
          </RateController>
        </ReactiveFallback>
        <RecoveryNode number_of_retries="1" name="FollowPath">
          <FollowPath path="{path}" controller_id="{selected_controller}"/>
          <ClearEntireCostmap name="ClearLocalCostmap-Context" service_name="local_costmap/clear_entirely_local_costmap"/>
        </RecoveryNode>
      </PipelineSequence>
      <ReactiveFallback name="RecoveryFallback">
        <GoalUpdated/>
        <RoundRobin name="RecoveryActions">
          <Sequence name="ClearingActions">
            <ClearEntireCostmap name="ClearLocalCostmap-Subtree" service_name="local_costmap/clear_entirely_local_costmap"/>
            <ClearEntireCostmap name="ClearGlobalCostmap-Subtree" service_name="global_costmap/clear_entirely_global_costmap"/>
          </Sequence>
          <Spin spin_dist="1.57"/>
          <Wait wait_duration="5"/>
          <BackUp backup_dist="0.30" backup_speed="0.05"/>
        </RoundRobin>
      </ReactiveFallback>
    </RecoveryNode>
  </BehaviorTree>
</root>
