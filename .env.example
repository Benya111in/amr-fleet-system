# docker compose 환경변수 — 이 파일을 .env 로 복사해 값을 채운다 (.env 는 git 에 올리지 않는다).
#
#   cp .env.example .env
#
# 서버 하나를 여러 명이 같이 쓰면 compose 프로젝트 이름·컨테이너·볼륨·ROS 도메인·Gazebo
# 파티션이 전부 사람마다 달라야 서로의 컨테이너를 재생성하거나 토픽이 섞이는 일이 없다.
# (network_mode: host 라서 같은 ROS_DOMAIN_ID 를 쓰면 서로의 토픽이 보인다.)

# compose 프로젝트 이름 = 컨테이너/볼륨 접두어. 기본값은 디렉토리 이름이라 같은 이름으로
# 클론한 두 사람이 충돌한다 → 반드시 사람마다 다르게.
COMPOSE_PROJECT_NAME=amr_<영문소문자이름>    # 영문 소문자/숫자/_/- 만 허용 (예: amr_hong)

# ROS2 DDS 도메인 (0~101 정수). 사람마다 다른 값 (예: 11).
ROS_DOMAIN_ID=<0~101 정수>

# Gazebo transport 파티션. 사람마다 다른 값 (한 사람의 컨테이너들끼리는 같아야 한다).
IGN_PARTITION=amr_<영문소문자이름>          # 예: amr_hong

# 1 이면 DDS 트래픽을 localhost 로 제한 (LAN 의 다른 호스트와 격리). 컨테이너끼리는 계속 통신된다.
ROS_LOCALHOST_ONLY=0
