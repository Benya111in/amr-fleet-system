# 커버리지/테스트 산출물
coverage/
*.gcov
*.gcda
*.gcno
lcov.info

# 런타임 로그 (디렉토리 구조는 .gitkeep 으로 유지)
logs/*
!logs/.gitkeep
# run_integration.sh 의 표준출력을 저장소 루트로 돌려받을 때 생기는 찌꺼기.
# 실제 산출물은 logs/<태그>/ 아래에 있고 그건 위에서 이미 제외한다 — 루트 사본만 막는다.
/run_*.log

# 생성된 맵 (성과물 맵은 별도 커밋)
maps/*.pgm
maps/*.yaml
!maps/.gitkeep

# rosbag
*.mcap
*.db3
rosbag2_*/

# YOLO 가중치 (대용량 — 스크립트로 내려받는다)
*.pt
*.onnx
*.engine
src/amr_perception/models/*
!src/amr_perception/models/.gitkeep

# Gazebo
.gazebo/
.ignition/

# 에디터/OS
.vscode/
.idea/
*.swp
.DS_Store

# 환경변수
.env

# C++ 커버리지 측정용 별도 빌드 (scripts/cpp_coverage.sh)
build_cov/
install_cov/
